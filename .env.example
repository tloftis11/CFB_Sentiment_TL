# Get a free API key at: https://collegefootballdata.com/key
CFBD_API_KEY=your_key_here

# Season year (defaults to current year)
CFB_SEASON_YEAR=2026

# Limit Google Trends to Power 4 + top G5 only (faster, set to false for all FBS)
TRENDS_POWER_ONLY=true

# Log level: DEBUG, INFO, WARNING
LOG_LEVEL=INFO
